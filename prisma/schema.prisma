generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model companies {
  id         Int       @id @default(autoincrement())
  symbol     String    @unique
  name_fa    String?
  industry   String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  filings    filings[]
}

model filings {
  id                   Int                    @id @default(autoincrement())
  company_id           Int
  statement_type       statement_type
  period_end_date      DateTime               @db.Date
  fiscal_quarter       String?
  audited              Boolean                @default(false)
  amended              Boolean                @default(false)
  consolidated         Boolean                @default(false)
  source_url           String?
  fetched_at           DateTime               @default(now()) @db.Timestamptz(6)
  companies            companies              @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  standard_line_items  standard_line_items[]
  statement_line_items statement_line_items[]

  @@unique([company_id, statement_type, period_end_date, audited, amended, consolidated])
  @@index([company_id], map: "idx_filings_company")
}

model line_item_mapping {
  label_fa       String
  statement_type statement_type
  canonical_key  String

  @@id([label_fa, statement_type])
}

model standard_line_items {
  id           Int     @id @default(autoincrement())
  filing_id    Int
  standard_key String
  value        Decimal @db.Decimal
  filings      filings @relation(fields: [filing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([filing_id, standard_key])
  @@index([filing_id], map: "idx_standard_items_filing")
  @@index([standard_key], map: "idx_standard_items_key")
}

model statement_line_items {
  id            Int      @id @default(autoincrement())
  filing_id     Int
  canonical_key String?
  label_fa      String
  value         Decimal? @db.Decimal
  filings       filings  @relation(fields: [filing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([filing_id, label_fa])
  @@index([canonical_key], map: "idx_line_items_canonical")
  @@index([filing_id], map: "idx_line_items_filing")
}

enum statement_type {
  balance_sheet
  income_statement
  cash_flow
}
